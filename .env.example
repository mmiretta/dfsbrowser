# Copy to .env and adjust. Every variable is optional unless noted.

# Host address and port the browser is published on. Keep 127.0.0.1 unless a
# reverse proxy on another host needs to reach it.
DFS_BROWSER_HOST_BIND=127.0.0.1
DFS_BROWSER_PORT=8888

# HTTP Basic credentials required for every page and API call.
# Strongly recommended whenever the port is reachable by anyone but you.
DFS_BROWSER_AUTH_USER=
DFS_BROWSER_AUTH_PASSWORD=

# Comma-separated list of S3 endpoints users may connect to. Leave empty to allow
# any endpoint (only sensible on localhost).
DFS_BROWSER_ALLOWED_ENDPOINTS=https://s3.example.com

# Values pre-filled in the login form.
DFS_BROWSER_DEFAULT_ENDPOINT=https://s3.example.com
DFS_BROWSER_DEFAULT_BUCKET=dfs
DFS_BROWSER_DEFAULT_REGION=us-east-1

# Disable uploads.
DFS_BROWSER_READ_ONLY=false

# Session lifetime in seconds (default 12 h) and largest file accepted for
# upload or assembled for download, in MiB (default 512).
DFS_BROWSER_SESSION_TTL_SECS=43200
DFS_BROWSER_MAX_FILE_MB=512

RUST_LOG=dfs_browser=info,actix_web=warn

