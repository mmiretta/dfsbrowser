# Settings for the demo profile:
#   docker compose --env-file demo/demo.env --profile demo up -d --build
# Then open http://127.0.0.1:8888 and log in with the demo credentials below.

DFS_BROWSER_DEFAULT_ENDPOINT=http://demo-minio:9000
DFS_BROWSER_ALLOWED_ENDPOINTS=http://demo-minio:9000
DFS_BROWSER_DEFAULT_BUCKET=dfs

# Throwaway credentials for the demo MinIO, which is not published on the host.
DEMO_MINIO_USER=demo-admin
DEMO_MINIO_PASSWORD=demo-password-change-me
